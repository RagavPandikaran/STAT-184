# ==================== PROBLEM 3 ====================

#Part A 

two_sample_t <- function(x, y, equal_var = FALSE, alpha = 0.05) {
  
  n1 <- length(x)
  n2 <- length(y)
  
  avg1 <- mean(x)
  avg2 <- mean(y)
  
  variance1 <- var(x)
  variance2 <- var(y)
  
  if (equal_var) {
    
    method <- "Pooled"
    
    combined_var <- ((n1 - 1) * variance1 +
                       (n2 - 1) * variance2) / (n1 + n2 - 2)
    
    standard_error <- sqrt(combined_var * (1 / n1 + 1 / n2))
    
    df <- n1 + n2 - 2
    
  } else {
    
    method <- "Welch"
    
    standard_error <- sqrt(variance1 / n1 + variance2 / n2)
    
    df <- (variance1 / n1 + variance2 / n2)^2 /
      ((variance1 / n1)^2 / (n1 - 1) +
         (variance2 / n2)^2 / (n2 - 1))
  }
  
  t_stat <- (avg1 - avg2) / standard_error
  
  p_value <- 2 * pt(
    abs(t_stat),
    df = df,
    lower.tail = FALSE
  )
  
  reject <- p_value < alpha
  
  return(list(
    method = method,
    t_stat = t_stat,
    df = df,
    p_value = p_value,
    reject = reject
  ))
}


# ---- Part B ----

B <- 1000
n_x <- 20
n_y <- 40
alpha <- 0.05

scenarios <- data.frame(
  scenario = c("equal_null", "unequal_null",
               "equal_shift", "unequal_shift"),
  mean_x = c(0, 0, 0, 0),
  mean_y = c(0, 0, 1, 1),
  sd_x = c(1, 3, 1, 3),
  sd_y = c(1, 1, 1, 1)
)

# Storage is allocated before the simulation:
# 4 scenarios x 1000 repetitions x 2 methods = 8000 rows.
total_runs <- nrow(scenarios) * B * 2

saved_scenario <- character(total_runs)
saved_replicate <- integer(total_runs)
saved_method <- character(total_runs)
saved_t <- numeric(total_runs)
saved_df <- numeric(total_runs)
saved_p <- numeric(total_runs)
saved_reject <- logical(total_runs)

# The seed is set once, immediately before the loops.
set.seed(2026)

position <- 0

for (scenario_num in seq_len(nrow(scenarios))) {
  
  for (repeat_num in seq_len(B)) {
    
    # Fresh samples for each repetition; both methods use the same samples.
    sample_x <- rnorm(
      n_x,
      mean = scenarios$mean_x[scenario_num],
      sd = scenarios$sd_x[scenario_num]
    )
    
    sample_y <- rnorm(
      n_y,
      mean = scenarios$mean_y[scenario_num],
      sd = scenarios$sd_y[scenario_num]
    )
    
    for (use_equal in c(FALSE, TRUE)) {
      
      position <- position + 1
      
      test_result <- two_sample_t(
        sample_x,
        sample_y,
        equal_var = use_equal,
        alpha = alpha
      )
      
      saved_scenario[position] <- scenarios$scenario[scenario_num]
      saved_replicate[position] <- repeat_num
      saved_method[position] <- test_result$method
      saved_t[position] <- test_result$t_stat
      saved_df[position] <- test_result$df
      saved_p[position] <- test_result$p_value
      saved_reject[position] <- test_result$reject
    }
  }
}

simulation_results <- data.frame(
  scenario = saved_scenario,
  replicate = saved_replicate,
  method = saved_method,
  t_stat = saved_t,
  df = saved_df,
  p_value = saved_p,
  reject = saved_reject
)

